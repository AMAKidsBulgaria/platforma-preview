},
{
"t": "Колко ушички имаш?",
"f": "zr_e8f325a992.mp3"
},
{
"t": "Колко колела има триколката?",
"f": "zr_46e7ab6fff.mp3"
},
{
"t": "Колко крачета има кученцето?",
"f": "zr_03191f30a1.mp3"
},
{
"t": "Колко пръстчета има едната ти ръка?",

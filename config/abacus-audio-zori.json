},
{
"t": "Гледай как го правя!",
"f": "zr_3977b9f0c1.mp3"
},
{
"t": "Гледай как се прави.",
"f": "zr_a8fb911a99.mp3"
},
{
"t": "Да видим дали помниш!",
"f": "zr_f03c75c8f8.mp3"
},
{
"t": "Да видим кои цифри познаваш!",
